# Solana RPC endpoint (defaults to devnet if not set)
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# SPL token mint used for vote gating (created via scripts/setup-devnet.ts)
NEXT_PUBLIC_GATE_MINT=6JeDjgobNYjSzuUUyEaiNnzphBDgVYcwf3u9HLNtPu17

# Arcium MXE program ID — leave empty for dev mode (local encryption)
# Set to your deployed program's public key (NOT the Arcium framework program)
# The MXE account must be initialized via `arcium init-mxe` for this program
NEXT_PUBLIC_MXE_PROGRAM_ID=

# Network: devnet (cluster 456) or mainnet-beta (cluster 2026)
NEXT_PUBLIC_CLUSTER_OFFSET=456
NEXT_PUBLIC_NETWORK=devnet

# Circuit hash for on-chain verification (SHA-256 of compiled circuit binary)
# Compute with: cd arcis/voting-circuit && arcis build && sha256sum target/arcis/voting_circuit.so | cut -d' ' -f1
# Falls back to source hash if not set: 9f175fdae79a2f2d1da57ee9833d39dead99e1396e4ed75029d01cad8956bb71
NEXT_PUBLIC_CIRCUIT_HASH=

# Gate token mint authority keypair (JSON array or base64)
# Required for the /api/faucet endpoint to mint test tokens
GATE_MINT_AUTHORITY=
